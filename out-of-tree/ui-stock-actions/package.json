{
  "name": "@zitro/dsh-oot-ui-stock-actions",
  "description": "Stock action set binding gestures to out-of-tree surfaces",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@zitro/dsh-oot-ui-actions",
        "@zitro/dsh-oot-ui-overlay",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsc -b . && tsdown",
    "watch": "tsdown --watch",
    "check": "tsc -p tsconfig.tests.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:^",
    "@zitro/dsh-oot-ui-actions": "workspace:^",
    "@zitro/dsh-oot-ui-overlay": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {}
}
