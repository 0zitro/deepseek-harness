{
  // Out-of-tree client typecheck aggregate, mirroring tsconfig.client.json's
  // role for packages/client: noEmit over the OOT tests, with the package
  // projects referenced so their declarations build first. Not referenced by
  // the root solution — OOT typechecks on its own invocation:
  //
  //     tsc -b out-of-tree/tsconfig.client.json
  "extends": "../tsconfig.base.client.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"]
  },
  "include": [
    "*/src/css-modules.d.ts",
    "*/src/client/css-modules.d.ts",
    "*/tests/**/*.ts",
    "*/tests/**/*.tsx"
  ],
  "references": [
    { "path": "../packages/test-support/client-runtime" },
    { "path": "../packages/client/ui-renderer" },
    { "path": "../packages/api/session-controller/tsconfig.client.json" },
    { "path": "../packages/api/workspace-controller/tsconfig.client.json" },
    { "path": "./ui-widgets" },
    { "path": "./ui-actions" },
    { "path": "./ui-overlay" },
    { "path": "./ui-stock-actions" }
  ]
}
