{
  "name": "@zitro/dsh-oot-ui-overlay",
  "description": "Overlay manager (LIFO mount order, DOM-event bridge) and the OverlayScope primitive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsc -b . && tsdown",
    "watch": "tsdown --watch",
    "check": "tsc -p tsconfig.tests.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:^",
    "@types/react": "~18.3.1",
    "@zitro/dsh-oot-ui-actions": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {}
}
